    resultados_lab = correr_experimento(N_parametros, repeticiones=REPETICIONES, 
                                        M_aleatorios=M_ALEATORIOS, M_ordenados=M_ORDENADOS)
    
    graficar_resultados(N_parametros, resultados_lab, 
